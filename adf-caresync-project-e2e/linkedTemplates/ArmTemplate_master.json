{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync-project-e2e"
		},
		"Dstorage_caresync_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Dstorage_caresync'"
		},
		"AzureDatabricks_caresync_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1110-094648-o9otodqz"
		},
		"AzureKeyVault_SQL_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://sqlxkeyvault.vault.azure.net/"
		},
		"AzureKeyVault_caresync_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-pswrd.vault.azure.net/"
		},
		"Dstorage_caresync_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dstoragexcaresyncxprj.dfs.core.windows.net/"
		},
		"PostgreSource_caresync_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-mute-pine-a1ygo6m7-pooler.ap-southeast-1.aws.neon.tech"
		},
		"PostgreSource_caresync_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"PostgreSource_caresync_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"SourceLinkServiceCareSync_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dstoragexcaresyncxprj.dfs.core.windows.net/"
		},
		"sqldb_audit_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-servername.database.windows.net"
		},
		"sqldb_audit_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresync-database"
		},
		"sqldb_audit_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "caresync"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync-project-e2e_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Dstorage_caresync_accountKey": {
						"value": "[parameters('Dstorage_caresync_accountKey')]"
					},
					"AzureKeyVault_SQL_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault_SQL_properties_typeProperties_baseUrl')]"
					},
					"AzureKeyVault_caresync_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault_caresync_properties_typeProperties_baseUrl')]"
					},
					"Dstorage_caresync_properties_typeProperties_url": {
						"value": "[parameters('Dstorage_caresync_properties_typeProperties_url')]"
					},
					"SourceLinkServiceCareSync_properties_typeProperties_url": {
						"value": "[parameters('SourceLinkServiceCareSync_properties_typeProperties_url')]"
					},
					"AzureDatabricks_caresync_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks_caresync_properties_typeProperties_existingClusterId')]"
					},
					"PostgreSource_caresync_properties_typeProperties_server": {
						"value": "[parameters('PostgreSource_caresync_properties_typeProperties_server')]"
					},
					"PostgreSource_caresync_properties_typeProperties_database": {
						"value": "[parameters('PostgreSource_caresync_properties_typeProperties_database')]"
					},
					"PostgreSource_caresync_properties_typeProperties_username": {
						"value": "[parameters('PostgreSource_caresync_properties_typeProperties_username')]"
					},
					"sqldb_audit_properties_typeProperties_server": {
						"value": "[parameters('sqldb_audit_properties_typeProperties_server')]"
					},
					"sqldb_audit_properties_typeProperties_database": {
						"value": "[parameters('sqldb_audit_properties_typeProperties_database')]"
					},
					"sqldb_audit_properties_typeProperties_userName": {
						"value": "[parameters('sqldb_audit_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}